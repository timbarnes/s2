; P2: lambda, closures, rest arguments, let, tail calls.
(define (fib n) (if (< n 2) n (+ (fib (- n 1)) (fib (- n 2)))))
(display (fib 20)) (newline)
(define (compose f g) (lambda (x) (f (g x))))
(display ((compose car cdr) '(1 2 3))) (newline)
(define (add n) (lambda (x) (+ x n)))
(define add5 (add 5))
(display (add5 10)) (newline)
(define (curry3 f) (lambda (a) (lambda (b) (lambda (c) (f a b c)))))
(display ((((curry3 +) 1) 2) 3)) (newline)
(display ((lambda args args) 1 2 3)) (newline)
(display ((lambda (a . r) r) 1)) (newline)
(define (f a b . c) (cons (+ a b) c))
(display (f 1 2 3 4)) (newline)
(display (let ((x 1) (y 2)) (+ x y))) (newline)
(define x 10)
(display (let ((x 1) (y x)) (cons x y))) (newline)
(display (let ((a 1)) (+ (let ((b 2)) b) (let ((c 3)) c) a))) (newline)
(display ((lambda (car) car) 5)) (newline)
(define (count n acc) (if (= n 0) acc (count (- n 1) (+ acc 1))))
(display (count 100000 0)) (newline)
(display fib) (newline)
(display (lambda (x) x)) (newline)
