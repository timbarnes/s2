; P4: set!, letrec, internal definitions, named let.
(define (make-counter) (let ((n 0)) (lambda () (set! n (+ n 1)) n)))
(define c (make-counter))
(define d (make-counter))
(c) (c) (d)
(display (cons (c) (d))) (newline)
(define (cell v) (cons (lambda () v) (lambda (x) (set! v x))))
(define p (cell 1))
((cdr p) 42)
(display ((car p))) (newline)
(define g 1)
(set! g (+ g 1))
(display g) (newline)
(define (f x) (set! x (* x 10)) x)
(display (f 4)) (newline)
(define (parity n)
  (define (even? n) (if (= n 0) #t (odd? (- n 1))))
  (define (odd? n) (if (= n 0) #f (even? (- n 1))))
  (cons (even? n) (odd? n)))
(display (parity 7)) (newline)
(display (parity 100000)) (newline)
(display (letrec ((fact (lambda (n) (if (= n 0) 1 (* n (fact (- n 1))))))) (fact 20))) (newline)
(display (letrec* ((a 1) (b (+ a 1))) (cons a b))) (newline)
(display (let loop ((i 0) (acc '())) (if (= i 5) acc (loop (+ i 1) (cons i acc))))) (newline)
(display (let loop ((i 0)) (if (= i 100000) 'done (loop (+ i 1))))) (newline)
(define (f2) (define a 1) (define b (+ a 1)) (define (g) (* a b)) (g))
(display (f2)) (newline)
(define x 'global)
(define (f3) (define x 'local) x)
(display (cons (f3) x)) (newline)
(define (accum total) (lambda (n) (set! total (+ total n)) total))
(define acc (accum 100))
(acc 10)
(display (acc 10)) (newline)
