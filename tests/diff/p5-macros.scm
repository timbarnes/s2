; P5: syntax-rules, hygiene, derived forms, quasiquote.
(define-syntax swap! (syntax-rules () ((_ a b) (let ((tmp a)) (set! a b) (set! b tmp)))))
(display (let ((tmp 1) (other 2)) (swap! tmp other) (list tmp other))) (newline)
(define-syntax my-if (syntax-rules () ((_ c t e) (cond (c t) (else e)))))
(display (let ((else #f) (cond 'shadowed)) (my-if #t 'yes 'no))) (newline)
(display (let ((x 'outer)) (let-syntax ((m (syntax-rules () ((m) x)))) (let ((x 'inner)) (m))))) (newline)
(define-syntax my-or (syntax-rules () ((_) #f) ((_ e) e) ((_ e1 e2 ...) (let ((temp e1)) (if temp temp (my-or e2 ...))))))
(display (let ((x #f) (y 7) (temp 8) (let null?) (if pair?)) (my-or x (let temp) (if y) y))) (newline)
(define (tail-through-macro n) (my-or #f (if (= n 0) 'bottom (tail-through-macro (- n 1)))))
(display (tail-through-macro 100000)) (newline)
(define-syntax part-2
  (syntax-rules ()
    ((_ a b (m n) ... x y) (vector (list a b) (list m ...) (list n ...) (list x y)))
    ((_ . rest) 'error)))
(display (part-2 10 (+ 21 22) (31 32) (41 42) (51 52) (+ 61 2) 77)) (newline)
(define-syntax flatten (syntax-rules () ((_ (a b ...) ...) '(b ... ...))))
(display (flatten (1 2 3) (4 5))) (newline)
(define-syntax elli-esc (syntax-rules () ((_) '(... ...)) ((_ x) '(... (x ...)))))
(display (list (elli-esc) (elli-esc 100))) (newline)
(define-syntax be-like-begin
  (syntax-rules ()
    ((_ name) (define-syntax name (syntax-rules () ((name expr (... ...)) (begin expr (... ...))))))))
(be-like-begin sequence)
(display (sequence 0 1 2 3)) (newline)
(define-syntax jabberwocky
  (syntax-rules ()
    ((_ hatter) (begin (define march-hare 42) (define-syntax hatter (syntax-rules () ((_) march-hare)))))))
(jabberwocky mad-hatter)
(display (mad-hatter)) (newline)
(display (let () (define-syntax fwd (syntax-rules () ((_) (later)))) (define (use) (fwd)) (define (later) 42) (use))) (newline)
(define counter 0)
(define-syntax bump! (syntax-rules () ((_) (set! counter (+ counter 1)))))
(let ((counter 'shadowed)) (bump!) (bump!))
(display counter) (newline)
(display (let ((=> #f)) (cond (#t => 'ok)))) (newline)
(display (list (and 1 2) (or #f 3) (when #t 1) (unless #f 4))) (newline)
(display (case (* 2 3) ((2 3 5 7) 'prime) ((1 4 6 8 9) 'composite))) (newline)
(display (case 3 ((3) => (lambda (x) (+ x 1))) (else 'b))) (newline)
(display (do ((i 0 (+ i 1)) (acc '() (cons i acc))) ((= i 3) acc))) (newline)
(display (let ((loop 'mine)) (do ((i 0 (+ i 1)) (acc '() (cons loop acc))) ((= i 2) acc)))) (newline)
(display (let* ((a 1) (b (+ a 1))) (list a b))) (newline)
(display `(1 ,(+ 1 1) ,@(list 3 4))) (newline)
(display `#(1 ,(+ 1 1))) (newline)
(display ``(a ,(b ,(+ 1 2)))) (newline)
(display (let ((quote list)) `(x y))) (newline)
