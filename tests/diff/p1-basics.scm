; P1: constants, arithmetic, if, define, nested calls, pairs.
(display 42) (newline)
(display (+ 1 2 3)) (newline)
(display (- 10 1 2)) (newline)
(display (- 5)) (newline)
(display (* 6 7)) (newline)
(display (* 1152921504606846975 4)) (newline)
(define x 10)
(display (if (< x 20) (+ x 1) 0)) (newline)
(display (if (> x 20) 'big 'small)) (newline)
(display (if 0 'zero-is-true 'no)) (newline)
(display (+ (* 2 3) (- 10 (* 2 2)))) (newline)
(display (cons 1 (cons 2 '()))) (newline)
(display (car (cdr '(a b c)))) (newline)
(display '(1 . 2)) (newline)
(display "a string") (newline)
(display #\a) (newline)
(display (= 1 1 1)) (newline)
(define x (* x x))
(display x) (newline)
(begin (display "b") (display "c") (newline))
