template top-level
   0  MakeClosure k0   ; #<template compose>
   1  GlobalDefine k1  ; compose
   2  Return
template compose  arity 2
   0  LocalRef 0       ; f
   1  LocalRef 1       ; g
   2  MakeClosure k0   ; #<template>
   3  Return
template (lambda)  arity 1  free 2
   0  FreeRef 0        ; f
   1  FreeRef 1        ; g
   2  LocalRef 0       ; x
   3  Call 1
   4  TailCall 1
template top-level
