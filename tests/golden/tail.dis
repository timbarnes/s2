template top-level
   0  MakeClosure k0   ; #<template loop>
   1  GlobalDefine k1  ; loop
   2  Return
template loop  arity 2
   0  LocalRef 0       ; n
   1  JumpIfNotImm NumEq 0 →4
   2  LocalRef 1       ; acc
   3  Return
   4  GlobalRef k0     ; loop
   5  LocalRef 0       ; n
   6  SubImm 1
   7  LocalRef 1       ; acc
   8  AddImm 1
   9  TailCall 2
template top-level
   0  MakeClosure k0   ; #<template f>
   1  GlobalDefine k1  ; f
   2  Return
template f  arity 1
   0  LocalRef 0       ; g
   1  Fixnum 1
   2  Call 1
   3  Pop
   4  Fixnum 2
   5  LocalRef 0       ; g
   6  LocalRef 1       ; x
   7  TailCall 1
